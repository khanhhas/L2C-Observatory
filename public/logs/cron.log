    // Bước 2: Gọi API lấy dữ liệu thực tế kèm Cookie và tham số chống cache thời gian thực
    $timestamp = round(microtime(true) * 1000);
    $url = "https://thoatnuochanoi.vn/map/api/getAllData?_=" . $timestamp;
    
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 15,
        CURLOPT_COOKIEJAR => $cookie_file,
        CURLOPT_COOKIEFILE => $cookie_file,
        CURLOPT_POST => true, 
        CURLOPT_POSTFIELDS => "{}", // Gửi JSON body rỗng chuẩn cURL cho ASP.NET backend
        CURLOPT_HTTPHEADER => [
            'Accept: application/json, text/javascript, */*; q=0.01',
            'Accept-Language: en-US,en;q=0.9,vi;q=0.8',
            'Cache-Control: no-cache, no-store, must-revalidate',
            'Pragma: no-cache',
            'Connection: keep-alive',
            'Content-Type: application/json; charset=UTF-8',
            'Origin: https://thoatnuochanoi.vn',
            'Referer: https://thoatnuochanoi.vn/map/',
            'Sec-Fetch-Dest: empty',
            'Sec-Fetch-Mode: cors',
            'Sec-Fetch-Site: same-origin',
            'User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36',
            'X-Requested-With: XMLHttpRequest'
        ],
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_SSL_VERIFYHOST => false
    ]);
    
    $response = curl_exec($ch);
    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_error($ch);
    curl_close($ch);
    
    if ($http_code != 200 || !$response) {
        logMessage("ERROR", "HSDC API Failed: HTTP $http_code. CURL Error: $err.");
        return false;
    }
    
    $data = json_decode($response, true);
    
    if (!isset($data['data']) || !is_array($data['data'])) {
        $snippet = substr(trim(strip_tags($response)), 0, 150);
        logMessage("ERROR", "HSDC API: Lỗi định dạng dữ liệu: " . $snippet);
        return false;
    }

    $danger_stations = [];
    $map_stations = []; 

    $levelMetadata = [
        1 => ["range" => "0 - 20mm", "name" => "Mưa nhỏ / Không mưa", "status" => "An toàn", "desc" => "Lượng mưa 0 - 20mm. An toàn, không gây ngập úng, giao thông bình thường."],
        2 => ["range" => "20 - 50mm", "name" => "Mưa vừa", "status" => "Theo dõi", "desc" => "Lượng mưa 20 - 50mm. Có thể đọng nước cục bộ tại các điểm trũng thấp, đi lại cơ bản bình thường."],
        3 => ["range" => "50 - 70mm", "name" => "Mưa to", "status" => "Cảnh báo ngập nhẹ", "desc" => "Lượng mưa 50 - 70mm. Bắt đầu xuất hiện ngập 10 - 20cm tại các tuyến phố trũng thấp."],
        4 => ["range" => "70 - 90mm", "name" => "Mưa rất to", "status" => "Báo động ngập úng", "desc" => "Lượng mưa 70 - 90mm. Ngập úng diện rộng 20 - 30cm tại các điểm đen nội đô, giao thông khó khăn."],
        5 => ["range" => "90 - 100mm", "name" => "Mưa rất to đến đặc biệt to", "status" => "Nguy hiểm ngập sâu", "desc" => "Lượng mưa 90 - 100mm. Ngập sâu 30 - 50cm diện rộng, xe máy và ô tô con nguy cơ chết máy cao."],
        6 => ["range" => ">100mm", "name" => "Mưa cực đoan / Đặc biệt to", "status" => "Nguy cấp", "desc" => "Lượng mưa vượt 100mm. Quá tải toàn bộ hệ thống thoát nước, ngập sâu diện rộng, khuyến cáo hạn chế ra đường."]
    ];

    foreach ($data['data'] as $station) {
        $st_lng = isset($station['Lng']) ? (float)$station['Lng'] : 0; 
        $st_lat = isset($station['Lat']) ? (float)$station['Lat'] : 0;
        $name = isset($station['TenTram']) ? $station['TenTram'] : 'Unknown';
        $icon = isset($station['Icon']) ? $station['Icon'] : 'level1.png';
        $tramId = isset($station['TramId']) ? $station['TramId'] : '0';

        if ($st_lat === 0 || $st_lng === 0) continue;

        $level = 1;
        if (preg_match('/level(\d+)\.png/i', $icon, $matches)) {
            $level = (int)$matches[1];
        }
        if ($level < 1) $level = 1;
        if ($level > 6) $level = 6;

        $meta = $levelMetadata[$level];
        $rainKey = "level" . $level;
        $rainDescFormatted = "{$meta['name']} ({$meta['range']}): Lượng mưa {$meta['range']}. {$meta['desc']}";

        $map_stations[] = [
            'TramId' => (string)$tramId,
            'TenTram' => $name,
            'Lng' => (string)$st_lng,
            'Lat' => (string)$st_lat,
            'Icon' => $icon,
            'rain' => $rainKey,
            'rain_desc' => $rainDescFormatted,
            'rain_info' => [
                'level' => $level,
                'range_mm' => $meta['range'],
                'name' => $meta['name'],
                'status' => $meta['status'],
                'desc' => $meta['desc']
            ]
        ];

        $dLat = deg2rad($st_lat - $l2c_lat);
        $dLon = deg2rad($st_lng - $l2c_lon);
        $a = sin($dLat/2) * sin($dLat/2) + cos(deg2rad($l2c_lat)) * cos(deg2rad($st_lat)) * sin($dLon/2) * sin($dLon/2);
        $distance = 6371 * (2 * atan2(sqrt($a), sqrt(1-$a)));

        if ($distance <= $alert_radius_km && $level >= 3) {
            $danger_stations[] = [
                'name' => $name,
                'distance' => round($distance, 1),
                'level' => $level
            ];
        }
    }

    file_put_contents(__DIR__ . '/hsdc_rain.json', json_encode([
        'code' => 1,
        'timestamp' => time(),
        'data' => $map_stations
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));

    logMessage("INFO", "HSDC API: Cập nhật thành công qua Cookie-Session cURL (" . count($map_stations) . " trạm)!");
    return $danger_stations; 
